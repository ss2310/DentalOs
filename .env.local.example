# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — used only from a server-side API route (see CLAUDE.md)
ANTHROPIC_API_KEY=

# Cashfree Payments — hosted checkout. Server-side only (keys never reach the
# browser). CASHFREE_ENV: sandbox (default) | production. Order creation uses the
# cashfree-pg Node SDK; the browser launches checkout with the payment_session_id.
# The return_url is built from NEXT_PUBLIC_APP_URL (below) — set that too.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Groq — speech-to-text for Voice Notes (whisper-large-v3), server-side only.
# Needed only when the `voice_notes` feature flag is enabled for a clinic.
GROQ_API_KEY=

# Voice Notes global kill-switch. The feature is ON unless this is explicitly set
# to a falsy value (false/0/off/no). Turning it off disables Voice Notes for
# EVERY clinic regardless of their per-clinic flag — a platform-wide brake for
# runaway Groq/Anthropic spend. Leave blank/unset in normal operation.
ENABLE_VOICE_NOTES=
# Max voice notes a single clinic can create per day (bounds transcription +
# agent cost). Optional — defaults to 100.
VOICE_NOTES_DAILY_CAP=100

# Multi-vertical UI gate. DEFAULT OFF — production is dental-only and shows no
# vertical UI at all (settings/onboarding dropdowns hidden, /admin/verticals is
# 404). Set to true/1/on/yes ONLY once a paying non-dental clinic exists. The
# underlying vertical columns + resolveForVertical fallback (migration 026) are
# always active; this flag only controls whether the UI is visible.
ENABLE_MULTI_VERTICAL=false

# Model for the voice-notes extraction agent (lib/agent/notes-agent.ts). Uses
# ANTHROPIC_API_KEY above. Optional — defaults to claude-sonnet-4-6.
NOTES_AGENT_MODEL=claude-sonnet-4-6

# Shared secret for the audio-retention cron (/api/cron/purge-voice-audio).
# The scheduler must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# SERP provider for the Grid Rank Tracker (server-side only — keys never reach
# the client). SERP_PROVIDER: serper (primary) | serpapi (backup) | mock.
# ⚠ PRODUCTION MUST SET serper — the code DEFAULT IS mock (fake rankings).
# Unset/unknown defaults to "mock" — free, offline, deterministic (dev/testing).
SERP_PROVIDER=mock
SERPER_API_KEY=
SERPAPI_API_KEY=
# Scans allowed per clinic per calendar month (default 15). One Run Scan = 1,
# regardless of grid size. Credit top-ups beyond this come once payments are live.
SERP_MONTHLY_SCAN_CAP=15

# Deep Audit engine (Stages 1–3) — all server-side only, keys never reach the
# client. Places (New) for GBP data, PageSpeed Insights for site performance;
# website_llm classification uses ANTHROPIC_API_KEY above.
GOOGLE_MAPS_API_KEY=
PAGESPEED_API_KEY=
# Free deep audits included per billing cycle (code default 1); extras are ₹599 packs.
DEEP_AUDIT_MONTHLY_LIMIT=1
# Optional override for the website_llm classifier model (defaults to
# NOTES_AGENT_MODEL, else claude-sonnet-4-6).
# AUDIT_CLASSIFY_MODEL=

# Stage 4 (AI-visibility) engines — all server-side only.
#  - Gemini with Google Search grounding.
#  - Perplexity Sonar + ChatGPT run through ONE OpenRouter key (OpenAI-compatible).
# Any engine whose key is unset is skipped (logged), never fails the run.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# google_aio uses SERPER_API_KEY above. Model overrides (defaults shown):
# AUDIT_GEMINI_MODEL=gemini-2.5-flash
# AUDIT_SONAR_MODEL=perplexity/sonar
# AUDIT_CHATGPT_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Resend — transactional email (welcome email). Server-side only.
# RESEND_FROM must be an address on a domain you've verified in Resend, e.g.
# "GrowthOS <hello@yourdomain.com>". For quick testing without a domain, use
# "onboarding@resend.dev" (only delivers to your own Resend account email).
RESEND_API_KEY=
RESEND_FROM=
# Your app's public URL (e.g. https://your-app.vercel.app) — used for the
# "Open GrowthOS" button in the welcome email. Leave blank to omit the button.
APP_URL=
# Same public URL, but exposed to the browser (NEXT_PUBLIC_). Used to build the
# post-visit survey link (/s/<token>) and the public prospect-report link that
# staff send patients over WhatsApp. Falls back to window.origin when unset, so
# it's only strictly needed when the browser origin differs from the link you
# want patients to open (e.g. behind a proxy or custom domain).
NEXT_PUBLIC_APP_URL=
